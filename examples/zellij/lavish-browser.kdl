// Add this block to Zellij's config.kdl after installing the WASM and helper.
// The first load prompts for ReadApplicationState and RunCommands permissions.
// Build with: cargo build --locked -p lavish-browser-zellij --release --target wasm32-wasip1
load_plugins {
    "file:/absolute/path/to/lavish_browser_zellij.wasm" {
        helper_path "/absolute/path/to/lavish-browser-ctl"
        debug "false"
    }
}
