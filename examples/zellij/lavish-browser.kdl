// Add this block to Zellij's config.kdl after running scripts/install.sh.
// The first load prompts for ReadApplicationState and RunCommands permissions.
load_plugins {
    "file:/usr/local/share/lavish-browser/zellij/lavish-browser-zellij.wasm" {
        helper_path "/usr/local/bin/lavish-browser-ctl"
        debug "false"
    }
}
